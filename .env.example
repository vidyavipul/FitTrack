# Copy to .env and fill in the blanks.

# MySQL — use a dedicated app user, not root (see README "Set up the database")
DATABASE_USER=fittrack
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=fittrack_db

# Required, at least 32 characters:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Comma-separated origins allowed to call the API from another host
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
